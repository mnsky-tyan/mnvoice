# mnvoice configuration
# Copy to mnvoice.env next to mnvoice.exe.
# Environment variables with the same names take precedence.

# Deepgram (Default - $200 free credit, ultra-fast Nova-3 / Whisper):
PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en

# Groq (Whisper Large V3 Turbo):
# PROVIDER=groq
# GROQ_API_KEY=gsk_your_groq_key_here
# GROQ_MODEL=whisper-large-v3-turbo
# GROQ_LANGUAGE=en

# Common options:
# MAX_SECONDS=120
# TRAILING_SPACE=1
# KEYWORDS=mnvoice, herdr, TypeSafe, WASAPI

