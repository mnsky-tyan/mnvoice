# mnvoice configuration
# Copy to mnvoice.env next to mnvoice.exe (or export as environment variables).

# ---------------------------------------------------------------------------
# SPEECH PROVIDER
# ---------------------------------------------------------------------------
# PROTOCOL: "streaming" (WebSocket real-time, default) or "rest" (HTTP)
# API_KEY:  Your speech API key or auth token

# Option A - Real-time WebSocket streaming (lowest latency, recommended)
PROTOCOL=streaming
API_KEY=your_api_key_here
MODEL=nova-3
LANGUAGE=en
# BASE_URL=https://api.deepgram.com

# Option B - Standard REST audio/transcriptions (OpenAI-compatible)
# PROTOCOL=rest
# API_KEY=your_api_key_here
# MODEL=whisper-large-v3-turbo
# BASE_URL=https://api.groq.com
# LANGUAGE=en

# ---------------------------------------------------------------------------
# KEYBINDINGS
# ---------------------------------------------------------------------------
# HOTKEY:     Trigger hotkey to start / stop dictation (default: Alt+Space)
# CANCEL_KEY: Key to cancel and discard the current recording (default: Escape)
#
# Format: [Modifier+]Key
# Modifiers: Alt, Ctrl, Shift, Win
# Keys:      Space, Escape, Tab, Enter, F1-F24, A-Z, 0-9,
#            Home, End, PageUp, PageDown, Insert, Delete, BackQuote
# Examples:
#   HOTKEY=Alt+Space
#   HOTKEY=Ctrl+Shift+D
#   HOTKEY=F9
#   CANCEL_KEY=Escape
#   CANCEL_KEY=none

HOTKEY=Alt+Space
CANCEL_KEY=Escape

# ---------------------------------------------------------------------------
# ORB APPEARANCE
# ---------------------------------------------------------------------------
# ORB_COLOR:        Fluid color. Preset names or #RRGGBB hex.
#                   Presets: hot_pink (default), cyan, purple, blue,
#                            emerald, amber, red, white
# ORB_FLUID_LEVEL:  How full the orb looks. 0.0 (mist) to 1.0 (full).
#                   Also accepts percentages: 75%
# Examples:
#   ORB_COLOR=hot_pink
#   ORB_COLOR=#A855F7
#   ORB_FLUID_LEVEL=0.75
#   ORB_FLUID_LEVEL=50%

ORB_COLOR=hot_pink
ORB_FLUID_LEVEL=0.75

# ---------------------------------------------------------------------------
# OTHER SETTINGS
# ---------------------------------------------------------------------------
# KEYWORDS:       Comma-separated custom words to improve recognition accuracy.
#                 Also reads keywords.txt beside the exe automatically.
# MAX_SECONDS:    Maximum recording duration before auto-stop (default: 120)
# TRAILING_SPACE: Append a space after each dictation (default: 1, set 0 to disable)

# KEYWORDS=pi, herdr, Kubernetes, TypeScript
# MAX_SECONDS=120
# TRAILING_SPACE=1
