# mnvoice configuration
#
# Copy to mnvoice.env next to mnvoice.exe (or export these as environment variables).
#
# Keys are grouped by how widely they apply:
#   [GLOBAL]  work with any provider and any API key
#
# Delete this file at any time to return to defaults (filler words stripped).

# ===========================================================================
# GLOBAL - which provider you talk to
# ===========================================================================
# PROTOCOL: "streaming" (real-time, lowest latency) or "rest" (batch upload)
# API_KEY:  your API key or auth token
#
# Deepgram is the recommended streaming provider. Any provider works - the
# rest of this file is selected by PROTOCOL, not by vendor.

# --- Option A: WebSocket streaming -----------------------------------------
PROTOCOL=streaming
API_KEY=your_api_key_here
MODEL=nova-3
LANGUAGE=en
# BASE_URL=https://api.deepgram.com

# --- Option B: OpenAI-compatible REST (Groq, OpenAI, self-hosted Whisper) --
# PROTOCOL=rest
# API_KEY=your_api_key_here
# MODEL=whisper-large-v3-turbo
# BASE_URL=https://api.groq.com
# LANGUAGE=en

# ===========================================================================
# GLOBAL - behaviour, independent of provider
# ===========================================================================
# HOTKEY:            trigger to start / stop. [Modifier+]Key
#                    Modifiers: Alt, Ctrl, Shift, Win
#                    Keys: Space, Escape, Tab, Enter, F1-F24, A-Z, 0-9,
#                          Home, End, PageUp, PageDown, Insert, Delete
#                    e.g. F9, Ctrl+Shift+D, Win+Alt+Space
HOTKEY=Alt+Space

# CANCEL_KEY:        discard the recording and drop everything spoken
#                    "none" disables it
CANCEL_KEY=Escape

# FILLER_WORDS:      0 = strip "uh"/"um"/"erm" (default)
#                    1 = keep them verbatim
#                    Streaming asks the provider to do it. REST has no such
#                    setting anywhere, so mnvoice filters locally instead.
FILLER_WORDS=0

# KEYWORDS:          words to bias recognition toward (jargon, names, acronyms).
#                    Also auto-loaded from keywords.txt beside the exe.
# KEYWORDS=Kubernetes, TypeScript, PostgreSQL

# AUTO_UPDATE:       1 = install a newer published release automatically.
#                    Off by default: replacing a running binary is a decision,
#                    not a default. Unset, empty, or anything unrecognised
#                    means off.
#                    Checks at most once a day. Never substitutes mnvoice.env
#                    or keywords.txt - those stay exactly as you set them.
#                    Tray menu > Check for updates does the same thing by hand.
# AUTO_UPDATE=1

# MAX_SECONDS:       hard recording limit before forced stop
# MAX_SECONDS=120

# TRAILING_SPACE:    1 = append a space after each dictation, 0 = do not
# TRAILING_SPACE=1

# VAD_SILENCE_MS:    silence after speech that stops recording.
#                    Raise if it cuts you off mid-sentence, lower for faster turnaround.
# VAD_SILENCE_MS=3000

# VAD_RMS_THRESHOLD: mic energy treated as speech (0-32767).
#                    Raise if background noise keeps it listening forever,
#                    lower if it misses quiet speech.
# VAD_RMS_THRESHOLD=400

# ===========================================================================
# GLOBAL - indicator orb
# ===========================================================================
# ORB_COLOR:        hot_pink, cyan, purple, blue, emerald, amber, red, white
#                   or any #RRGGBB hex code
ORB_COLOR=hot_pink

# ORB_FLUID_LEVEL:  0.0 (wispy mist) to 1.0 (full). Percentages accepted: 75%
ORB_FLUID_LEVEL=0.75
