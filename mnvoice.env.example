# mnvoice configuration
# Copy to mnvoice.env next to mnvoice.exe (or export as environment variables).

# --- Configuration Options ---
# PROTOCOL: "streaming" (WebSocket real-time, default) or "rest" (HTTP OpenAI-compatible endpoint)
# API_KEY: Your speech recognition API key or authentication token
# MODEL: Model identifier (e.g. "nova-3", "whisper-large-v3-turbo", "whisper-1")
# LANGUAGE: Language code (e.g. "en", "auto")
# BASE_URL: Endpoint URL (WebSocket or HTTPS URL)

# Option A: Real-Time WebSocket Streaming (Lowest latency, recommended)
# Compatible with WebSocket STT providers (e.g. Deepgram Nova-3, self-hosted streaming ASR)
PROTOCOL=streaming
API_KEY=your_api_key_here
MODEL=nova-3
LANGUAGE=en
# BASE_URL=https://api.deepgram.com

# Option B: Standard REST Audio Transcriptions
# Compatible with any OpenAI-compatible audio/transcriptions endpoint (Groq, OpenAI, self-hosted Whisper, vLLM, etc.)
# PROTOCOL=rest
# API_KEY=your_api_key_here
# MODEL=whisper-large-v3-turbo
# BASE_URL=https://api.groq.com
# LANGUAGE=en

# Common settings:
# MAX_SECONDS=120
# TRAILING_SPACE=1
# KEYWORDS=pi, herdr, chocobar, mn
